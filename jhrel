#!/usr/bin/env bash
# Complete Jarvis-HEP wheel/sdist preparation. Explicit --upload publishes tested artifacts.
_jhrel_SRC="$0"
if [[ -n "${BASH_VERSION:-}" ]]; then
  _jhrel_SRC="${BASH_SOURCE[0]}"
elif [[ -n "${ZSH_VERSION:-}" ]]; then
  _jhrel_SRC="$(eval 'echo ${(%):-%x}')"
fi
_jhrel_DIR="$(cd "$(dirname "$_jhrel_SRC")" && pwd)"
jhrel() { bash "$_jhrel_DIR/scripts/full-release.sh" "$@"; }
_jhrel_sourced=0
if [[ -n "${BASH_VERSION:-}" ]]; then
  [[ "${BASH_SOURCE[0]}" != "$0" ]] && _jhrel_sourced=1
elif [[ -n "${ZSH_VERSION:-}" ]]; then
  case "${ZSH_EVAL_CONTEXT:-}" in *:file) _jhrel_sourced=1 ;; esac
fi
if [[ "$_jhrel_sourced" -eq 0 ]]; then
  jhrel "$@"
fi

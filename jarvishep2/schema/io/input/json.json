{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-hep.org/schema/v2/io/input/json.json",
  "type": "object",
  "x-jarvis-example": "name: input\npath: input.json\ntype: JSON\nactions:\n  - type: Dump\n    variables:\n      - name: x\n        expression: x",
  "required": [
    "name",
    "path",
    "type"
  ],
  "properties": {
    "name": {
      "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
      "description": "Logical name of this IO slot."
    },
    "path": {
      "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
      "description": "File path relative to the calculator execution directory."
    },
    "type": {
      "const": "JSON",
      "description": "Portal format name for this IO entry."
    },
    "save": {
      "type": "boolean",
      "description": "Keep the file after the sample finishes when true."
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "variables"
        ],
        "properties": {
          "type": {
            "const": "Dump",
            "description": "Portal format name for this IO entry."
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "expression"
              ],
              "properties": {
                "name": {
                  "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
                  "description": "Logical name of this IO slot."
                },
                "expression": {
                  "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
                  "description": "Expression evaluated in the sample namespace."
                },
                "entry": {
                  "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
                  "description": "Key or path inside the file payload."
                }
              },
              "additionalProperties": false,
              "x-jarvis-zone": "delegated"
            },
            "description": "Variable bindings for this action."
          }
        },
        "additionalProperties": false,
        "x-jarvis-zone": "delegated"
      },
      "description": "Ordered Portal actions (Dump/Load/...) for this file."
    }
  },
  "additionalProperties": false,
  "x-jarvis-zone": "delegated",
  "description": "Portal input format JSON: YAML field vocabulary for execution.input[]."
}

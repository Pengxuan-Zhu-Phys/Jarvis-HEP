      "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"
    },
    "type": {
      "const": "TSV"
    },
    "save": {
      "type": "boolean"
    }
  },
  "additionalProperties": true,
  "x-jarvis-zone": "delegated"
}

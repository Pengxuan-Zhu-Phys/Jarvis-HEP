{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-hep.org/schema/v2/sampling/methods/random.json",
  "type": "object",
  "x-jarvis-zone": "closed",
  "description": "Independent random proposals in the unit cube.",
  "x-jarvis-example": "Method: Random\nBounds:\n  Point number: 100\n  Seed: 0\nVariables:\n  - name: x\n    distribution:\n      type: Flat\n      parameters: {min: 0.0, max: 1.0}",
  "allOf": [
    {"$ref": "https://jarvis-hep.org/schema/v2/sampling/methods/variables.json"},
    {
      "properties": {
        "Method": {"const": "Random"},
        "Bounds": {
          "type": "object",
          "x-jarvis-zone": "closed",
          "description": "Random-method knobs. Closed: unknown keys are rejected.",
          "properties": {
            "Point number": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/integerish",
              "description": "How many independent points to propose (alias: point_number)."
            },
            "point_number": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/integerish",
              "description": "Alias of Point number."
            },
            "Seed": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/integerish",
              "description": "RNG seed (alias: seed)."
            },
            "seed": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/integerish",
              "description": "Alias of Seed."
            }
          },
          "anyOf": [
            {"required": ["Point number"]},
            {"required": ["point_number"]}
          ],
          "additionalProperties": false
        }
      },
      "required": ["Bounds"]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-hep.org/schema/v2/core/common.json",
  "$defs": {
    "nonemptyString": {"type": "string", "minLength": 1},
    "command": {"type": "object", "properties": {"cmd": {"$ref": "#/$defs/nonemptyString"}, "command": {"$ref": "#/$defs/nonemptyString"}, "cwd": {"$ref": "#/$defs/nonemptyString"}}, "anyOf": [{"required": ["cmd"]}, {"required": ["command"]}], "additionalProperties": false},
    "variable": {"type": "object", "required": ["name", "distribution"], "properties": {"name": {"$ref": "#/$defs/nonemptyString"}, "description": {"type": "string"}, "distribution": {"$ref": "#/$defs/distribution"}}, "additionalProperties": false},
    "distribution": {"type": "object", "required": ["type", "parameters"], "properties": {"type": {"enum": ["Flat", "Log", "Logit", "Normal", "Log-Normal"]}, "parameters": {"type": "object"}}, "additionalProperties": false},
    "csv": {"type": "object", "required": ["path"], "properties": {"path": {"$ref": "#/$defs/nonemptyString"}, "uuid_column": {"$ref": "#/$defs/nonemptyString"}, "variables": {"type": "array", "items": {"$ref": "#/$defs/nonemptyString"}}}, "additionalProperties": false},
    "operasIO": {"type": "object", "required": ["name"], "properties": {"name": {"$ref": "#/$defs/nonemptyString"}, "entry": {"$ref": "#/$defs/nonemptyString"}, "expression": {"$ref": "#/$defs/nonemptyString"}}, "additionalProperties": false}
  }
}

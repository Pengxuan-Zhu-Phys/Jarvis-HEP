{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-hep.org/schema/v2/core/sampling.json",
  "type": "object",
  "x-jarvis-zone": "closed",
  "description": "Sampling root is cross-cutting only. Method-specific sampler knobs (radius, point_number, seed, AdaptiveBridson targets, CSV path, dynesty/MCMC kwargs, ...) live exclusively under Bounds.",
  "properties": {
    "Method": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"},
    "Variables": {
      "type": "array",
      "items": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/variable"}
    },
    "Bounds": {
      "type": "object",
      "x-jarvis-zone": "delegated",
      "additionalProperties": true,
      "description": "Method-specific sampler settings (see sampling/methods/*.json)."
    },
    "selection": {"type": "string"},
    "on_failure": {"type": "string"},
    "mode": {"type": "string"},
    "data": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"},
    "points_csv": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"},
    "LogLikelihood": {"type": "array"},
    "Mapper": {
      "type": "array",
      "x-jarvis-zone": "closed",
      "description": "Optional pure u->physical reparameterization after Variables[].distribution (D22). Ordered list of {name, expression}. Omitted -> distribution-only mapping (backward compatible). Expressions see Variables and prior Mapper names only (closed namespace). List form keeps schema keys fixed (name/expression) instead of user symbols as object keys.",
      "items": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/mapperEntry"},
      "x-jarvis-example": "Mapper:\n  - name: x\n    expression: \"cos(t)\"\n  - name: y\n    expression: \"sin(t)\""
    },
    "Nuisance": {
      "type": "object",
      "x-jarvis-zone": "closed",
      "description": "Profile1D nuisance configuration. Its nested keys use lower snake_case.",
      "properties": {
        "method": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"},
        "max_attempt": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/integerish"},
        "variables": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/variable"}
        },
        "log_likelihood": {
          "type": "array",
          "items": {
            "type": "object",
            "x-jarvis-zone": "closed",
            "required": ["name", "expression"],
            "properties": {
              "name": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"},
              "expression": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"}
            },
            "additionalProperties": false
          }
        },
        "target_mode": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"},
        "rerun_physics": {"type": "boolean"},
        "pass_condition": {
          "type": "array",
          "items": {
            "type": "object",
            "x-jarvis-zone": "closed",
            "required": ["name", "expression"],
            "properties": {
              "name": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"},
              "expression": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "FeedbackReturn": {
      "type": "object",
      "x-jarvis-zone": "delegated",
      "additionalProperties": true
    },
    "Control": {
      "type": "object",
      "x-jarvis-zone": "open",
      "x-jarvis-open-reason": "RLTPMCMC controller has not been migrated to the V2 contract."
    },
    "Diagnostics": {
      "type": "object",
      "x-jarvis-zone": "open",
      "x-jarvis-open-reason": "RLTPMCMC diagnostics has not been migrated to the V2 contract."
    },
    "PPO": {
      "type": "object",
      "x-jarvis-zone": "open",
      "x-jarvis-open-reason": "RLTPMCMC PPO settings have not been migrated to the V2 contract."
    },
    "Reward": {
      "type": "object",
      "x-jarvis-zone": "open",
      "x-jarvis-open-reason": "RLTPMCMC reward settings have not been migrated to the V2 contract."
    }
  },
  "additionalProperties": false
}

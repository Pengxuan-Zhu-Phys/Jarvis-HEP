{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://jarvis-hep.org/schema/v2/core/calculators.json",
    "type": "object",
    "properties": {
        "Modules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "name"
                ],
                "properties": {
                    "name": {
                        "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"
                    },
                    "path": {
                        "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"
                    },
                    "source": {
                        "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"
                    },
                    "clone_shadow": {
                        "type": "boolean"
                    },
                    "required_modules": {
                        "type": "array",
                        "items": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"}
                    },
                    "installation": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/commandList"},
                    "initialization": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/commandList"},
                    "timeout": {"type": "number", "exclusiveMinimum": 0},
                    "symlink_name": {"$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"},
                    "env_setup": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "object"}]}},
                    "selection": {"oneOf": [{"type": "string"}, {"type": "boolean"}]},
                    "make_paraller": {"type": "integer", "minimum": 1},
                    "modes": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
                    "execution": {
                        "type": "object",
                        "properties": {
                            "path": {
                                "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"
                            },
                            "commands": {
                                "type": "array",
                                "items": {
                                    "oneOf": [
                                        {
                                            "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString"
                                        },
                                        {
                                            "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/command"
                                        }
                                    ]
                                }
                            },
                            "input": {
                                "type": "array",
                                "items": {
                                    "type": "object"
                                }
                            },
                            "output": {
                                "type": "array",
                                "items": {
                                    "type": "object"
                                }
                            }
                        },
                        "additionalProperties": false
                    }
                },
                "additionalProperties": false
            }
        },
        "Pools": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "make_paraller": {"type": "integer", "minimum": 1},
        "Archiver": {"type": "object"},
        "Cleanup": {"type": "object"}
    },
    "additionalProperties": false
}

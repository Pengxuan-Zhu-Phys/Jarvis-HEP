{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-hep.org/schema/v2/sampling/methods/ptensemble.json",
  "type": "object",
  "x-jarvis-zone": "closed",
  "x-jarvis-status": "stable",
  "description": "Parallel-tempering ensemble MCMC.",
  "x-jarvis-example": "Method: PTEnsemble\nBounds:\n  num_chains: 8\n  num_iters: 2000\n  proposal_scale: 0.2\n  temperature_ladder: [1.0, 1.5, 2.2, 3.3, 5.0, 7.5, 11.0, 16.0]\n  exchange_interval: 1\n  stretch_a: 2.0\n  seed: 0\nVariables:\n  - name: x\n    distribution:\n      type: Flat\n      parameters: {min: 0.0, max: 1.0}",
  "allOf": [
    {
      "$ref": "https://jarvis-hep.org/schema/v2/sampling/methods/variables.json"
    },
    {
      "properties": {
        "Method": {
          "const": "PTEnsemble"
        },
        "Bounds": {
          "type": "object",
          "x-jarvis-zone": "closed",
          "description": "PTEnsemble settings. num_chains is the number of temperature replicas (must be >= 2) and equals temperature_ladder length.",
          "properties": {
            "num_chains": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveIntegerish",
              "description": "Number of temperature replicas (>= 2).",
              "minimum": 2
            },
            "num_iters": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveIntegerish",
              "description": "Number of stretch-move transitions per replica."
            },
            "proposal_scale": {
              "oneOf": [
                {
                  "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveNumeric"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveNumeric"
                  }
                }
              ],
              "description": "Fallback Gaussian scale; a scalar broadcasts to all replicas, a list gives one scale per replica."
            },
            "temperature_ladder": {
              "type": "array",
              "minItems": 2,
              "items": {
                "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveNumeric"
              },
              "description": "Strictly increasing temperatures; length equals num_chains; first entry must be 1.0 (cold)."
            },
            "exchange_interval": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveIntegerish",
              "description": "Attempt adjacent temperature swaps after this many full draws (default 1).",
              "default": 1
            },
            "stretch_a": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveNumeric",
              "exclusiveMinimum": 1,
              "description": "Stretch-move scale a > 1 (emcee convention; default 2.0)."
            },
            "seed": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonNegativeIntegerish",
              "description": "Master RNG seed (chain streams + exchange RNG)."
            },
            "on_failure": {
              "type": "string",
              "enum": ["reject", "halt"],
              "description": "Failed-sample policy: reject the Metropolis proposal or halt the scan (default reject)."
            }
          },
          "required": [
            "num_chains",
            "num_iters",
            "proposal_scale",
            "temperature_ladder"
          ],
          "additionalProperties": false
        }
      },
      "required": ["Bounds"]
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-hep.org/schema/v2/sampling/methods/ensemble_mcmc.json",
  "type": "object",
  "x-jarvis-zone": "closed",
  "x-jarvis-status": "stable",
  "description": "Stretch-move ensemble MCMC.",
  "x-jarvis-example": "Method: EnsembleMCMC\nBounds:\n  num_chains: 8\n  num_iters: 2000\n  proposal_scale: 0.2\n  stretch_a: 2.0\n  seed: 0\nVariables:\n  - name: x\n    distribution:\n      type: Flat\n      parameters: {min: 0.0, max: 1.0}",
  "allOf": [
    {
      "$ref": "https://jarvis-hep.org/schema/v2/sampling/methods/variables.json"
    },
    {
      "properties": {
        "Method": {
          "const": "EnsembleMCMC"
        },
        "Bounds": {
          "type": "object",
          "x-jarvis-zone": "closed",
          "description": "EnsembleMCMC settings. num_chains is the walker count and must be >= 2 (even counts pair halves evenly).",
          "properties": {
            "num_chains": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveIntegerish",
              "description": "Number of ensemble walkers (>= 2).",
              "minimum": 2
            },
            "num_iters": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveIntegerish",
              "description": "Number of stretch-move transitions per walker."
            },
            "proposal_scale": {
              "oneOf": [
                {
                  "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveNumeric"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveNumeric"
                  }
                }
              ],
              "description": "Fallback Gaussian scale when a complementary partner draw is unavailable; a scalar broadcasts."
            },
            "stretch_a": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveNumeric",
              "exclusiveMinimum": 1,
              "description": "Stretch-move scale a > 1 (emcee convention; default 2.0)."
            },
            "seed": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonNegativeIntegerish",
              "description": "Master RNG seed."
            },
            "on_failure": {
              "type": "string",
              "enum": ["reject", "halt"],
              "description": "Failed-sample policy: reject the Metropolis proposal or halt the scan (default reject)."
            }
          },
          "required": ["num_chains", "num_iters", "proposal_scale"],
          "additionalProperties": false
        }
      },
      "required": ["Bounds"]
    }
  ]
}

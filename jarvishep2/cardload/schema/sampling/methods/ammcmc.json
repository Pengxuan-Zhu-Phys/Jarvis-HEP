{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-hep.org/schema/v2/sampling/methods/ammcmc.json",
  "type": "object",
  "x-jarvis-zone": "closed",
  "x-jarvis-status": "stable",
  "description": "Adaptive Metropolis MCMC.",
  "x-jarvis-example": "Method: AMMCMC\nBounds:\n  num_chains: 4\n  num_iters: 2000\n  proposal_scale: 0.2\n  adapt_enabled: true\n  adapt_start_iter: 100\n  adapt_window: 25\n  seed: 0\nVariables:\n  - name: x\n    distribution:\n      type: Flat\n      parameters: {min: 0.0, max: 1.0}",
  "allOf": [
    {
      "$ref": "https://jarvis-hep.org/schema/v2/sampling/methods/variables.json"
    },
    {
      "properties": {
        "Method": {
          "const": "AMMCMC"
        },
        "Bounds": {
          "type": "object",
          "x-jarvis-zone": "closed",
          "description": "AMMCMC settings. proposal_scale may be per-chain. Prefer num_chains >= Runtime workers.",
          "properties": {
            "num_chains": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveIntegerish",
              "description": "Number of independent chains (async 1-inflight each; prefer >= workers)."
            },
            "num_iters": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveIntegerish",
              "description": "Number of transitions per chain."
            },
            "proposal_scale": {
              "oneOf": [
                {
                  "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveNumeric"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveNumeric"
                  }
                }
              ],
              "description": "Initial proposal scale; a scalar or one-element list broadcasts, while a full list maps one scale to each chain."
            },
            "adapt_enabled": {
              "type": "boolean",
              "description": "Enable adaptive covariance updates (default true)."
            },
            "adapt_start_iter": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveIntegerish",
              "description": "First iteration at which covariance adaptation may start (default 100)."
            },
            "adapt_window": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveIntegerish",
              "description": "Rolling window length for the empirical covariance (default 25)."
            },
            "adapt_eps": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/numeric",
              "minimum": 0,
              "description": "Diagonal ridge added to the adapted covariance (default 1e-6)."
            },
            "adapt_scale": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveNumeric",
              "description": "Overall scale of the adapted Gaussian proposal (default 2.38)."
            },
            "seed": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonNegativeIntegerish",
              "description": "Master RNG seed."
            },
            "on_failure": {
              "type": "string",
              "enum": ["reject", "halt"],
              "description": "Failed-sample policy: reject the Metropolis proposal or halt the scan (default reject)."
            }
          },
          "required": ["num_chains", "num_iters", "proposal_scale"],
          "additionalProperties": false
        }
      },
      "required": ["Bounds"]
    }
  ]
}

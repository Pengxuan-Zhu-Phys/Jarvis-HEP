{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-hep.org/schema/v2/sampling/methods/demcmc.json",
  "type": "object",
  "x-jarvis-zone": "closed",
  "x-jarvis-status": "stable",
  "description": "Differential-evolution MCMC.",
  "x-jarvis-example": "Method: DEMCMC\nBounds:\n  num_chains: 8\n  num_iters: 2000\n  proposal_scale: 0.2\n  de_gamma: 0.0\n  de_noise: 1.0e-3\n  de_crossover: 1.0\n  seed: 0\nVariables:\n  - name: x\n    distribution:\n      type: Flat\n      parameters: {min: 0.0, max: 1.0}",
  "allOf": [
    {
      "$ref": "https://jarvis-hep.org/schema/v2/sampling/methods/variables.json"
    },
    {
      "properties": {
        "Method": {
          "const": "DEMCMC"
        },
        "Bounds": {
          "type": "object",
          "x-jarvis-zone": "closed",
          "description": "DEMCMC settings. num_chains is the walker count and must be >= 2.",
          "properties": {
            "num_chains": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveIntegerish",
              "description": "Number of DE walkers (>= 2).",
              "minimum": 2
            },
            "num_iters": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveIntegerish",
              "description": "Number of DE transitions per walker."
            },
            "proposal_scale": {
              "oneOf": [
                {
                  "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveNumeric"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/positiveNumeric"
                  }
                }
              ],
              "description": "Fallback Gaussian scale when fewer than two complementary walkers are available; a scalar broadcasts."
            },
            "de_gamma": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/numeric",
              "minimum": 0,
              "description": "DE jump scale. 0 selects 2.38/sqrt(2*dim) (default 0)."
            },
            "de_noise": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/numeric",
              "minimum": 0,
              "description": "Gaussian noise amplitude added to the DE jump (default 1e-3)."
            },
            "de_crossover": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/numeric",
              "minimum": 0,
              "maximum": 1,
              "description": "Per-coordinate crossover probability in [0, 1] (default 1)."
            },
            "seed": {
              "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonNegativeIntegerish",
              "description": "Master RNG seed."
            },
            "on_failure": {
              "type": "string",
              "enum": ["reject", "halt"],
              "description": "Failed-sample policy: reject the Metropolis proposal or halt the scan (default reject)."
            }
          },
          "required": ["num_chains", "num_iters", "proposal_scale"],
          "additionalProperties": false
        }
      },
      "required": ["Bounds"]
    }
  ]
}

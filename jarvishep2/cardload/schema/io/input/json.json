{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis-hep.org/schema/v2/io/input/json.json",
  "type": "object",
  "x-jarvis-example": "name: input\npath: input.json\ntype: JSON\nactions:\n  - type: Dump\n    variables:\n      - {name: x}\n      - {name: scaled_x, expression: \"2 * x\"}\n      - {name: mass, entry: parameters.mass}\n      - {name: derived_mass, expression: \"sqrt(m2)\", entry: parameters.derived_mass}",
  "required": [
    "name",
    "path",
    "type"
  ],
  "properties": {
    "name": {
      "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
      "description": "Logical name of this IO slot."
    },
    "path": {
      "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
      "description": "File path relative to the calculator execution directory."
    },
    "type": {
      "const": "JSON",
      "description": "Portal file type name for this IO entry."
    },
    "save": {
      "type": "boolean",
      "description": "Keep the file after the sample finishes when true."
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "variables"
        ],
        "properties": {
          "type": {
            "const": "Dump",
            "description": "JSON input action name; the supported value is Dump."
          },
          "variables": {
            "type": "array",
            "items": {
              "oneOf": [
                {"$ref": "#/$defs/directRootVariable"},
                {"$ref": "#/$defs/directEntryVariable"},
                {"$ref": "#/$defs/expressionRootVariable"},
                {"$ref": "#/$defs/expressionEntryVariable"}
              ]
            },
            "description": "Variable bindings for this action."
          }
        },
        "additionalProperties": false,
        "x-jarvis-zone": "closed"
      },
      "description": "Ordered JSON input Dump actions for this file."
    }
  },
  "$defs": {
    "directRootVariable": {
      "type": "object",
      "x-jarvis-zone": "closed",
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
          "description": "Read this same-named value directly from the sample namespace and write it at the JSON root."
        }
      },
      "additionalProperties": false
    },
    "directEntryVariable": {
      "type": "object",
      "x-jarvis-zone": "closed",
      "required": ["name", "entry"],
      "properties": {
        "name": {
          "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
          "description": "Read this same-named value directly from the sample namespace."
        },
        "entry": {
          "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
          "description": "Required dotted destination path inside the JSON object."
        }
      },
      "additionalProperties": false
    },
    "expressionRootVariable": {
      "type": "object",
      "x-jarvis-zone": "closed",
      "required": ["name", "expression"],
      "properties": {
        "name": {
          "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
          "description": "Logical name recorded for the computed value."
        },
        "expression": {
          "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
          "description": "Expression evaluated in the sample namespace and written at the JSON root."
        }
      },
      "additionalProperties": false
    },
    "expressionEntryVariable": {
      "type": "object",
      "x-jarvis-zone": "closed",
      "required": ["name", "expression", "entry"],
      "properties": {
        "name": {
          "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
          "description": "Logical name recorded for the computed value."
        },
        "expression": {
          "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
          "description": "Expression evaluated in the sample namespace."
        },
        "entry": {
          "$ref": "https://jarvis-hep.org/schema/v2/core/common.json#/$defs/nonemptyString",
          "description": "Required dotted destination path inside the JSON object."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "x-jarvis-zone": "delegated",
  "description": "Portal input file type JSON: YAML field vocabulary for execution.input[]."
}
